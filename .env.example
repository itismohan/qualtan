# QUALTAN runtime
QUALTAN_ENV=development
QUALTAN_ARTIFACT_DIR=artifacts
QUALTAN_DEFAULT_MODEL=gpt-5-mini
QUALTAN_REASONING_MODEL=gpt-5
QUALTAN_MODEL_TIMEOUT_SECONDS=60
QUALTAN_MODEL_MAX_RETRIES=2
QUALTAN_MAX_MODEL_COST_USD=2.00

# Safety and execution policy
# Comma-separated non-production hosts that QUALTAN may target during an approved execution.
QUALTAN_ALLOWED_EXECUTION_HOSTS=staging.example.com,api-staging.example.com
# Keep false until an authorized administrator explicitly enables external mutations.
QUALTAN_ALLOW_EXTERNAL_MUTATIONS=false
QUALTAN_REQUIRE_APPROVAL_FOR_EXECUTION=true
QUALTAN_REQUIRE_APPROVAL_FOR_MUTATIONS=true
QUALTAN_REDACT_SENSITIVE_DATA=true

# LLM provider configuration. Never commit real credentials.
OPENAI_API_KEY=your_openai_api_key
# Optional override; use only your approved provider endpoint.
OPENAI_BASE_URL=

# Jira configuration
JIRA_URL=https://your-domain.atlassian.net
JIRA_USER=your-email@example.com
JIRA_TOKEN=your-jira-api-token
JIRA_ACCEPTANCE_CRITERIA_FIELD=customfield_10100

# X-Ray Cloud configuration
XRAY_CLIENT_ID=your_xray_client_id
XRAY_CLIENT_SECRET=your_xray_client_secret
XRAY_BASE_URL=https://xray.cloud.getxray.app/api/v2

# Approved non-production targets
BASE_URL=https://staging.example.com
API_BASE_URL=https://api-staging.example.com
GRAPHQL_ENDPOINT=https://api-staging.example.com/graphql

# Legacy Locust defaults (the governed workflow validates targets separately)
LOCUST_USERS=100
LOCUST_SPAWN_RATE=10
LOCUST_RUN_TIME=5m
